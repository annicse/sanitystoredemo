# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or real keys.

# Sanity project (https://www.sanity.io/manage) - public identifiers, not secrets
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional: defaults to a fixed API version in src/sanity/env.ts
# NEXT_PUBLIC_SANITY_API_VERSION="2026-11-02"

# Stripe TEST mode secret key (https://dashboard.stripe.com/test/apikeys)
# Server-side only. Must start with sk_test_ for this demo.
STRIPE_SECRET_KEY="sk_test_replace_me"

# Public base URL of the site. Used for Stripe success/cancel redirects and
# for absolute URLs in page metadata (Open Graph).
# Local: http://localhost:3000   Production: your deployed URL, without a trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
